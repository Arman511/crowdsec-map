{
  "name": "crowdsec-map",
  "version": "0.5.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "cross-env DATA_SOURCE=demo DEMO_SNAPSHOT_FILE=../demo-data/demo-snapshot.json GEOIP_DATABASE_DIR=../local concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "cd ../backend && cargo run --bin crowdsec_map",
    "dev:proxy": "vite --host 0.0.0.0",
    "build": "tsgo --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "lint:scss": "stylelint \"src/**/*.{css,scss}\"",
    "lint:scss:duplicates": "node scripts/check-duplicate-scss.js",
    "lint:scss:merge": "node scripts/merge-duplicate-scss.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "vite": "^8.3.4",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "cssnano": "^9.9.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.71.2",
    "vite-plugin-compression2": "^2.5.3"
  }
}
