#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)

printf '%s\n' '[pre-commit] Checking backend...'
cargo check --manifest-path "$repo_root/backend/Cargo.toml" --bin crowdsec_map

printf '%s\n' '[pre-commit] Building frontend...'
pnpm --dir "$repo_root/frontend" build

pnpm --dir "$repo_root/frontend" format

pnpm --dir "$repo_root/frontend" lint

printf '%s\n' '[pre-commit] Checks passed.'
